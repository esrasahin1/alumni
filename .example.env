# ==========================================
# Alumni Tracking System - Example Environment Variables
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production passwords here.
# ==========================================

# Application / Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL)
# Default 'db' matches the Docker Compose network service name.
# When running Node.js locally outside Docker, db.js automatically falls back to 'localhost'.
DB_HOST=db
DB_PORT=3306
DB_NAME=alumni_db
DB_USER=alumni_user
DB_PASSWORD=alumni_password

# MySQL Container Initialization (Docker Compose)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=alumni_db
MYSQL_USER=alumni_user
MYSQL_PASSWORD=alumni_password
